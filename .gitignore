!port/assets/
original/

# CI build outputs (tools/ci_build.py)
dist/

# the Cloudflare CLI's cache
/.cloudflare/
# the scorecard's 30 Hz baseline, which CI keeps in its cache (tools/scorecard/ci.py)
/.scorecard-baseline/
