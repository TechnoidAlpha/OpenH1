	<strings name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/hdr/help_strings">
		<string text=""/>
		<string text=""/>
		<string text="Brighter highlights on an HDR display. Auto turns it on while the display shows HDR; a display without HDR shows the game as it was."/>
		<string text="Faithful keeps the original picture and brightens its highlights. Punchy lifts the whole scene, as a remaster would.|The pictures are shown approximately: no SDR picture can show HDR."/>
		<string text="With HDR, how bright white surfaces and the HUD are, in nits. System matches your system's SDR brightness. Raise it in a bright room."/>
		<string text="With HDR, how bright the HUD and the menus are, in nits, apart from the picture. Paper White keeps them where paper white is. The HUD's glows stay as far above it."/>
		<string text=""/>
		<string text="The brightest the display shows, and its SDR white, as the system reports them."/>
	</strings>
